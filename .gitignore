# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Next.js build output ────────────────────────────────────────────────────
.next/
out/

# ─── TypeScript build output ─────────────────────────────────────────────────
dist/
*.tsbuildinfo

# ─── Test / coverage output ──────────────────────────────────────────────────
coverage/
.vitest-cache/

# ─── Environment variables ───────────────────────────────────────────────────
# .env.example is safe to commit — it contains only placeholders
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ─── Local-only mock data ────────────────────────────────────────────────────
# Optional local overlay for mock identity-match records (e.g. your own real
# phone number for end-to-end OTP testing). Never commit real PII.
lib/mock-mno-records.local.json

# ─── OS / editor noise ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ─── Misc ────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
