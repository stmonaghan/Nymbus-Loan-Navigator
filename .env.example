TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
USE_LIVE_IDENTITY_MATCH=false

# Secret used to sign stateless OTP session tokens (HMAC-SHA256).
# REQUIRED in production — set this to a long, random string. Without it,
# tokens are signed with an insecure built-in default. Generate one with e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# OPTIONAL — overlay for mock identity-match records, as a JSON string.
# Lets you test with your own real phone number in a deployed environment
# (e.g. Vercel) WITHOUT committing the number to the public repo. Same shape as
# lib/mock-mno-records.json; entries merge on top of the committed fixture and
# win on key collision. Leave unset to disable. Example (single line):
#   MNO_LOCAL_OVERLAY_JSON={"+15555559999":{"firstName":"Your","lastName":"Name","dob":"1990-01-01","addressLine1":"1 Test St","city":"Testville","state":"CA","postalCode":"90001","email":"you@example.com"}}
# MNO_LOCAL_OVERLAY_JSON=
